// Форматирование суммы прописью для подвала печатной формы
Функция СформироватьСуммуПрописью(ЧислоСуммы, КодВалюты = "RUB") Экспорт
	ПараметрыПредмета = "рубль, рубля, рублей, м, копейка, копейки, копеек, ж, 2";
	Если КодВалюты = "USD" Тогда
		ПараметрыПредмета = "доллар, доллара, долларов, м, цент, цента, центов, м, 2";
	ИначеЕсли КодВалюты = "EUR" Тогда
		ПараметрыПредмета = "евро, евро, евро, м, цент, цента, центов, м, 2";
	КонецЕсли;
	
	Возврат ЧислоПрописью(ЧислоСуммы, "L=ru_RU", ПараметрыПредмета);
КонецФункции
