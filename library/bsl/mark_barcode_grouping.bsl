// Группировка строк с одинаковой номенклатурой с объединением кодов маркировки
Функция СгруппироватьМаркировку(ТаблицаТоваров) Экспорт
	ТаблицаСвертки = ТаблицаТоваров.Скопировать();
	ТаблицаСвертки.Свернуть("Номенклатура, Характеристика, Цена", "Количество, Сумма");
	Возврат ТаблицаСвертки;
КонецФункции
