// Расчёт общего количества упаковок (мест) и базовых единиц
Процедура ПодсчитатьИтогиУпаковок(ТабличнаяЧасть, ИтогКоробок, ИтогШтук) Экспорт
	ИтогКоробок = 0;
	ИтогШтук = 0;
	Для Каждого СтрТЧ Из ТабличнаяЧасть Цикл
		ИтогШтук = ИтогШтук + СтрТЧ.Количество;
		Если ЗначениеЗаполнено(СтрТЧ.КоличествоУпаковок) Тогда
			ИтогКоробок = ИтогКоробок + СтрТЧ.КоличествоУпаковок;
		Иначе
			ИтогКоробок = ИтогКоробок + СтрТЧ.Количество;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры
