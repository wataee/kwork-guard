// Расчёт суммы НДС с поддержкой ставок 5%, 7%, 10%, 20% и БезНДС
Функция РассчитатьСуммуНДС(Сумма, СтавкаНДС) Экспорт
	Если СтавкаНДС = Перечисления.СтавкиНДС.НДС20 ИЛИ СтавкаНДС = "20%" Тогда
		Возврат Окр(Сумма * 20 / 120, 2);
	ИначеЕсли СтавкаНДС = "5%" ИЛИ Строка(СтавкаНДС) = "5%" Тогда
		Возврат Окр(Сумма * 5 / 105, 2);
	ИначеЕсли СтавкаНДС = "7%" ИЛИ Строка(СтавкаНДС) = "7%" Тогда
		Возврат Окр(Сумма * 7 / 107, 2);
	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС10 ИЛИ СтавкаНДС = "10%" Тогда
		Возврат Окр(Сумма * 10 / 110, 2);
	Иначе
		Возврат 0; // Без НДС
	КонецЕсли;
КонецФункции
