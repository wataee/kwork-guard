// Формирование строки представления организации для шапки (ИНН, КПП, Адрес)
Функция ПредставлениеОрганизацииДляШапки(Организация) Экспорт
	Результат = "" + Организация.НаименованиеПолное;
	Если ЗначениеЗаполнено(Организация.ИНН) Тогда
		Результат = Результат + ", ИНН " + Организация.ИНН;
	КонецЕсли;
	Если ЗначениеЗаполнено(Организация.КПП) Тогда
		Результат = Результат + ", КПП " + Организация.КПП;
	КонецЕсли;
	Возврат Результат;
КонецФункции
